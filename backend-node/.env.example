PORT=8001
MONGODB_URI=mongodb://127.0.0.1:27017/auditoria_ganancias
MAX_UPLOAD_MB=20
TOLERANCIA_REDONDEO=0.05
NODE_ENV=development

# Sesion/login
# Los usuarios NO se definen aca: se guardan en MongoDB con password_hash.
# Crear usuario con: npm run usuario:crear -- --correo usuario@empresa.com
JWT_SECRET=cambiar-por-una-clave-larga-de-32-caracteres-minimo
SESSION_HOURS=8

# Explicaciones IA opcionales. Gemini no calcula impuestos: solo redacta hallazgos del motor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELOS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_REINTENTOS=3
GEMINI_REINTENTO_BASE_MS=1200
